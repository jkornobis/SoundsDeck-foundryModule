<section class="sounds-deck-board" aria-label="{{localize 'SOUNDS_DECK.Board'}}">
  <header class="sd-section-head"><h2 class="sd-section-title">{{localize "SOUNDS_DECK.BoardTitle"}}</h2></header>
  {{#if banks.length}}
  <search class="sd-filter">
    <input type="search" name="filter" placeholder="{{localize 'SOUNDS_DECK.Filter'}}" aria-label="{{localize 'SOUNDS_DECK.Filter'}}" autocomplete="off">
  </search>
  <div class="sd-tabs" role="group" aria-label="{{localize 'SOUNDS_DECK.Tabs.Label'}}">
    {{#each tabs}}
    <div class="sd-tab{{#if shown}} is-shown{{/if}}" data-playlist-id="{{id}}">
      <input type="checkbox" data-action="bankTick" {{#if shown}}checked{{/if}} aria-label="{{localize 'SOUNDS_DECK.Tabs.Tick' name=name}}" data-tooltip="{{localize 'SOUNDS_DECK.Tabs.Tick' name=name}}">
      <button type="button" data-action="bankSolo" aria-pressed="{{#if shown}}true{{else}}false{{/if}}" data-tooltip="{{localize 'SOUNDS_DECK.Tabs.Solo'}}">{{name}}</button>
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{#each banks}}
  <fieldset class="sd-bank sd-press-{{press}}" data-playlist-id="{{id}}" data-shown="{{#if shown}}true{{else}}false{{/if}}" {{#unless shown}}hidden{{/unless}} {{#unless press}}disabled{{/unless}}>
    <legend class="sd-bank-title" role="heading" aria-level="3">{{name}}</legend>
    <div class="sd-pads">
      {{#each pads}}
      <div class="sd-pad-cell sd-card{{#if playing}} is-playing{{/if}}{{#if colour}} sd-colour sd-colour-{{colour}}{{/if}}" data-pad-name="{{name}}">
        <button type="button" class="sd-pad" data-action="pad" data-sound-id="{{id}}" {{#if pressed}}aria-pressed="{{pressed}}"{{/if}} aria-label="{{label}}" data-tooltip="{{label}}{{#if description}}<br>{{description}}{{/if}}" {{#if description}}aria-description="{{description}}"{{/if}}><span class="sd-clamp">{{#if icon}}<span class="sd-pad-icon" aria-hidden="true">{{icon}}</span> {{/if}}{{label}}</span></button>
        {{#if previewable}}
        <div class="sd-card-actions">
          <button type="button" class="sd-preview{{#if previewing}} is-previewing{{/if}}" data-action="preview" data-sound-id="{{id}}" aria-pressed="{{#if previewing}}true{{else}}false{{/if}}" aria-label="{{localize 'SOUNDS_DECK.Preview' name=label}}" data-tooltip="{{#if previewing}}{{localize 'SOUNDS_DECK.PreviewOn'}}{{else}}{{localize 'SOUNDS_DECK.PreviewOff'}}{{/if}}"><i class="fa-solid fa-headphones" inert></i></button>
          <button type="button" class="sd-private" data-action="private" data-sound-id="{{id}}" aria-label="{{localize 'SOUNDS_DECK.Private.Button' name=label}}" data-tooltip="{{localize 'SOUNDS_DECK.Private.Tooltip'}}"><i class="fa-solid fa-user" inert></i></button>
          {{#if randomizable}}
          <button type="button" class="sd-random{{#if armed}} is-armed{{/if}}" data-action="randomToggle" data-sound-id="{{id}}" aria-pressed="{{#if armed}}true{{else}}false{{/if}}" aria-label="{{localize 'SOUNDS_DECK.Random' name=name}}" data-tooltip="{{#if armed}}{{localize 'SOUNDS_DECK.RandomOn'}}{{else}}{{localize 'SOUNDS_DECK.RandomOff'}}{{/if}}"><i class="fa-solid fa-dice" inert></i></button>
          {{/if}}
          {{#if (ne ducks null)}}
          <button type="button" class="sd-duck{{#unless ducks}} is-off{{/unless}}" data-action="duckToggle" data-sound-id="{{id}}" aria-pressed="{{#if ducks}}true{{else}}false{{/if}}" aria-label="{{localize 'SOUNDS_DECK.Ducks' name=name}}" data-tooltip="{{#if ducks}}{{localize 'SOUNDS_DECK.DucksOn'}}{{else}}{{localize 'SOUNDS_DECK.DucksOff'}}{{/if}}"><i class="fa-solid {{#if ducks}}fa-volume-low{{else}}fa-volume-high{{/if}}" inert></i></button>
          {{/if}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{#unless press}}<p class="sd-hint">{{localize "SOUNDS_DECK.NoPress"}}</p>{{/unless}}
  </fieldset>
  {{else}}
  <p class="sd-empty">{{localize "SOUNDS_DECK.NoBanks"}}</p>
  {{/each}}
</section>
