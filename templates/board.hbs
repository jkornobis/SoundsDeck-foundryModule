<section class="sounds-deck-board" aria-label="{{localize 'SOUNDS_DECK.Board'}}">
  {{#if banks.length}}
  <search class="sd-filter">
    <input type="search" name="filter" placeholder="{{localize 'SOUNDS_DECK.Filter'}}" aria-label="{{localize 'SOUNDS_DECK.Filter'}}" autocomplete="off">
  </search>
  {{/if}}
  {{#each banks}}
  <fieldset class="sd-bank sd-press-{{press}}" data-playlist-id="{{id}}" {{#unless press}}disabled{{/unless}}>
    <legend>{{name}}</legend>
    <div class="sd-pads">
      {{#each pads}}
      <div class="sd-pad-cell" data-pad-name="{{name}}">
        <button type="button" class="sd-pad{{#if playing}} is-playing{{/if}}" data-action="pad" data-sound-id="{{id}}" {{#if pressed}}aria-pressed="{{pressed}}"{{/if}}>{{name}}</button>
        {{#if (ne ducks null)}}
        <button type="button" class="sd-duck{{#unless ducks}} is-off{{/unless}}" data-action="duckToggle" data-sound-id="{{id}}" aria-pressed="{{#if ducks}}true{{else}}false{{/if}}" aria-label="{{localize 'SOUNDS_DECK.Ducks' name=name}}" data-tooltip="{{#if ducks}}{{localize 'SOUNDS_DECK.DucksOn'}}{{else}}{{localize 'SOUNDS_DECK.DucksOff'}}{{/if}}"><i class="fa-solid {{#if ducks}}fa-volume-low{{else}}fa-volume-high{{/if}}" inert></i></button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{#unless press}}<p class="sd-hint">{{localize "SOUNDS_DECK.NoPress"}}</p>{{/unless}}
  </fieldset>
  {{else}}
  <p class="sd-empty">{{localize "SOUNDS_DECK.NoBanks"}}</p>
  {{/each}}
  {{#if cues.length}}
  <section class="sd-transport" aria-label="{{localize 'SOUNDS_DECK.Transport'}}">
    {{#each cues}}
    <div class="sd-cue is-{{state}}" data-playlist-id="{{playlistId}}" data-sound-id="{{soundId}}">
      <span class="sd-cue-name">{{name}}</span>
      {{#if (eq state "playing")}}
      <button type="button" data-action="cuePause" aria-label="{{localize 'SOUNDS_DECK.Pause'}}" data-tooltip="{{localize 'SOUNDS_DECK.Pause'}}"><i class="fa-solid fa-pause" inert></i></button>
      {{else}}
      <button type="button" data-action="cueResume" aria-label="{{localize 'SOUNDS_DECK.Resume'}}" data-tooltip="{{localize 'SOUNDS_DECK.Resume'}}"><i class="fa-solid fa-play" inert></i></button>
      {{/if}}
      <button type="button" data-action="cueStop" aria-label="{{localize 'SOUNDS_DECK.Stop'}}" data-tooltip="{{localize 'SOUNDS_DECK.Stop'}}"><i class="fa-solid fa-stop" inert></i></button>
      <input type="range" min="0" max="1" step="1" value="0" aria-label="{{localize 'SOUNDS_DECK.Position'}}">
      <span class="sd-cue-time">{{at}}</span>
    </div>
    {{/each}}
  </section>
  {{/if}}
</section>
